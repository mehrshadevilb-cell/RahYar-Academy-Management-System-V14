# Telegram
BOT_TOKEN=
BOT_USERNAME=
PROXY_URL=

# Database
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_ME@postgres:5432/rahyar
REDIS_URL=redis://redis:6379/0

SPOTPLAYER_API_KEY=
OWNER_ID=

SITE_NAME=آکادمی راه‌یار
SITE_TAGLINE=آموزش حرفه‌ای موسیقی — دوره‌های دیجیتال و کلاس آنلاین

DEBUG=false
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# AI Developer Agent / shared dynamic provider pool
AI_AGENT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=180
AI_MODEL_REFRESH_INTERVAL_SECONDS=21600

# Provider pool. Keys are never committed.
ORCAROUTER_API_KEY=
KIRAAI_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
GOOGLE_API_KEY=
BYTEZ_API_KEY=
DAHL_API_KEY=

# Cloudflare Workers AI (OpenAI-compatible)
# 1) Create API token with Account → Workers AI → Read
# 2) Verify: curl https://api.cloudflare.com/client/v4/user/tokens/verify -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN"
# 3) Account ID: Cloudflare dashboard → right sidebar / Workers overview
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Optional override (auto-built from ACCOUNT_ID if empty):
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Wire Cloudflare into the router (replace YOUR_ACCOUNT_ID):
# AI_PROVIDERS_JSON=[{"name":"cloudflare","api_key_env":"CLOUDFLARE_API_TOKEN","base_url":"https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1","models":["@cf/meta/llama-3.1-8b-instruct"],"priority":25}]

# Server-to-server AI bridge used by ArtistYar Website.
RAHYAR_AI_BRIDGE_SECRET=

# Optional legacy secondary provider.
AI2_API_KEY=
AI2_BASE_URL=
AI2_MODEL=

# Optional explicit multi-provider JSON pool.
AI_PROVIDERS_JSON=

# Online write mode on Render (optional, owner only via Telegram panel)
AI_AGENT_WRITE_ENABLED=false
AI_AGENT_WORK_DIR=/tmp/rahyar-agent-repo
GITHUB_TOKEN=
GITHUB_REPO=mehrshadevilb-cell/RahYar-Academy-Management-System-V14

# Student chat assistant
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20

# AI knowledge engine
KNOWLEDGE_ENABLED=true
KNOWLEDGE_GROUP_IDS=
KNOWLEDGE_FETCH_INTERVAL_HOURS=24
KNOWLEDGE_AUTO_QUIZ=true
KNOWLEDGE_QUIZ_INTERVAL_HOURS=24
