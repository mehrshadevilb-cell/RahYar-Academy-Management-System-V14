# Telegram
BOT_TOKEN=

# Optional: only needed if you must reach Telegram through a local proxy (e.g. VPN/v2ray)
PROXY_URL=

# Database (Production: PostgreSQL)
POSTGRES_DB=rahyar
POSTGRES_USER=rahyar
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/rahyar

# Redis (reserved for background/distributed workloads)
REDIS_URL=redis://redis:6379/0

# SpotPlayer
SPOTPLAYER_API_KEY=

# Owner Telegram numeric ID
OWNER_ID=8234306902

# System
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# Default card-to-card payment card
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# Security
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET

# AI Developer Agent (disabled by default)
AI_AGENT_ENABLED=false
AI_AGENT_REPO_PATH=.
AI_AGENT_API_KEY=
AI_AGENT_BASE_URL=https://api.openai.com/v1
AI_AGENT_MODEL=gpt-5.6
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=120
