# Telegram
BOT_TOKEN=
BOT_USERNAME=
PROXY_URL=

# Database
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_ME@postgres:5432/rahyar
REDIS_URL=redis://redis:6379/0

SPOTPLAYER_API_KEY=
OWNER_ID=

SITE_NAME=آکادمی راه‌یار
SITE_TAGLINE=آموزش حرفه‌ای موسیقی — دوره‌های دیجیتال و کلاس آنلاین

DEBUG=false
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# AI Developer Agent (OrcaRouter example)
AI_AGENT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.orcarouter.ai/v1
AI_MODEL=deepseek/deepseek-v4-flash-free
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=180

# Online write mode on Render (optional, owner only via Telegram panel)
# Create a fine-grained GitHub PAT with: Contents Read/Write, Pull requests Read/Write
# on this repository only. Agent opens PRs on ai/* — never merges main.
AI_AGENT_WRITE_ENABLED=false
AI_AGENT_WORK_DIR=/tmp/rahyar-agent-repo
GITHUB_TOKEN=
GITHUB_REPO=mehrshadevilb-cell/RahYar-Academy-Management-System-V14

# Student chat assistant (reuses AI_* if chat keys empty)
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20
