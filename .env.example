# Telegram
BOT_TOKEN=
BOT_USERNAME=
# HTTPS URL opened from the bot's keyboard/menu as a Telegram Mini App.
TELEGRAM_WEB_APP_URL=https://artistyaar.ir
PROXY_URL=

# Database
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_ME@postgres:5432/rahyar
REDIS_URL=redis://redis:6379/0

SPOTPLAYER_API_KEY=
OWNER_ID=

SITE_NAME=آکادمی راه‌یار
SITE_TAGLINE=آموزش حرفه‌ای موسیقی — دوره‌های دیجیتال و کلاس آنلاین
WEB_ADMIN_API_KEY=replace-with-a-long-random-secret
ANALYTICS_HASH_SECRET=replace-with-a-different-long-random-secret

DEBUG=false
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# AI Developer Agent / shared dynamic provider pool
AI_AGENT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=180
AI_MODEL_REFRESH_INTERVAL_SECONDS=21600

# Provider pool. Keys are never committed.
ORCAROUTER_API_KEY=
KIRAAI_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
GOOGLE_API_KEY=
BYTEZ_API_KEY=
DAHL_API_KEY=

# Server-to-server AI bridge used by ArtistYar Website.
# Use the same strong random value in the bot and ArtistYar Render services.
RAHYAR_AI_BRIDGE_SECRET=

# Optional legacy secondary provider.
AI2_API_KEY=
AI2_BASE_URL=
AI2_MODEL=

# Optional explicit multi-provider JSON pool. When populated it takes precedence over built-in presets.
# API keys should be referenced by environment variable names; never commit secrets here.
AI_PROVIDERS_JSON=

# Online write mode on Render (optional, owner only via Telegram panel)
AI_AGENT_WRITE_ENABLED=false
AI_AGENT_WORK_DIR=/tmp/rahyar-agent-repo
GITHUB_TOKEN=
GITHUB_REPO=mehrshadevilb-cell/RahYar-Academy-Management-System-V14

# Student chat assistant
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20

# AI knowledge engine
KNOWLEDGE_ENABLED=true
KNOWLEDGE_GROUP_IDS=
KNOWLEDGE_FETCH_INTERVAL_HOURS=24
KNOWLEDGE_AUTO_QUIZ=true
KNOWLEDGE_QUIZ_INTERVAL_HOURS=24

# ArtistYar daily practice reminder bridge
ARTISTYAR_PRACTICE_API_URL=https://artistyaar.ir
ARTISTYAR_PRACTICE_REMINDER_SECRET=
ARTISTYAR_PRACTICE_REMINDER_HOUR=18
ARTISTYAR_PRACTICE_REMINDER_MINUTE=0
