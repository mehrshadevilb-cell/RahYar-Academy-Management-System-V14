# Telegram
BOT_TOKEN=

# Public bot username without @ (for website deep links, e.g. RahYarAcademyBot)
BOT_USERNAME=

# Optional: only needed if you must reach Telegram through a local proxy (e.g. VPN/v2ray)
PROXY_URL=

# Database (Production: PostgreSQL)
POSTGRES_DB=rahyar
POSTGRES_USER=rahyar
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/rahyar

# Redis (reserved for background/distributed workloads)
REDIS_URL=redis://redis:6379/0

# SpotPlayer
SPOTPLAYER_API_KEY=

# Owner Telegram numeric ID
OWNER_ID=8234306902

# Public website branding
SITE_NAME=آکادمی راه‌یار
SITE_TAGLINE=آموزش حرفه‌ای موسیقی — دوره‌های دیجیتال و کلاس آنلاین

# System
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# Default card-to-card payment card
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# Security
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# AI Developer Agent (owner-only Telegram panel: 🧠 AI Developer Agent)
# ---------------------------------------------------------------------------
# Example — OrcaRouter free model:
#   AI_AGENT_ENABLED=true
#   AI_API_KEY=sk-orca-...
#   AI_BASE_URL=https://api.orcarouter.ai/v1
#   AI_MODEL=deepseek/deepseek-v4-flash-free
AI_AGENT_ENABLED=false
AI_AGENT_REPO_PATH=.
AI_AGENT_API_KEY=
AI_AGENT_BASE_URL=https://api.openai.com/v1
AI_AGENT_MODEL=gpt-4o-mini
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=120

# Aliases (optional)
# AI_API_KEY=
# AI_BASE_URL=https://api.orcarouter.ai/v1
# AI_MODEL=deepseek/deepseek-v4-flash-free

# ---------------------------------------------------------------------------
# Student chat assistant (free-text answers when no menu button matches)
# ---------------------------------------------------------------------------
# If CHAT_ASSISTANT_API_KEY / BASE_URL / MODEL are empty, the bot reuses AI_*.
# Minimum to enable with the same OrcaRouter key already set for the agent:
#   CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_ENABLED=false
CHAT_ASSISTANT_API_KEY=
CHAT_ASSISTANT_BASE_URL=https://api.openai.com/v1
CHAT_ASSISTANT_MODEL=gpt-4o-mini
CHAT_ASSISTANT_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20
