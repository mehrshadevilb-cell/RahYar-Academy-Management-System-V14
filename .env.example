# Telegram
BOT_TOKEN=

# Optional: only needed if you must reach Telegram through a local proxy (e.g. VPN/v2ray)
PROXY_URL=

# Database (Production: PostgreSQL)
POSTGRES_DB=rahyar
POSTGRES_USER=rahyar
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/rahyar

# Redis (reserved for background/distributed workloads)
REDIS_URL=redis://redis:6379/0

# SpotPlayer
SPOTPLAYER_API_KEY=

# Owner Telegram numeric ID
OWNER_ID=8234306902

# System
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# Default card-to-card payment card
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# Security
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET

# AI Developer Agent (disabled by default). Can read/write repo files
# and commit to ai/* branches. Keep disabled unless you understand the
# risk - see .ai-agent/policy.md.
AI_AGENT_ENABLED=false
AI_AGENT_REPO_PATH=.
AI_AGENT_API_KEY=
AI_AGENT_BASE_URL=https://api.openai.com/v1
AI_AGENT_MODEL=gpt-5.6
AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=120

# Student-facing chat assistant (disabled by default). Read-only: never
# writes files or touches git. Answers student questions in Persian
# using the bot's real, current course catalog. Calls an external paid
# API per message, so it costs money once enabled - set a real API key
# and flip CHAT_ASSISTANT_ENABLED=true only when you're ready for that.
CHAT_ASSISTANT_ENABLED=false
CHAT_ASSISTANT_API_KEY=
CHAT_ASSISTANT_BASE_URL=https://api.openai.com/v1
CHAT_ASSISTANT_MODEL=gpt-5.6
CHAT_ASSISTANT_TIMEOUT_SECONDS=30
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20
