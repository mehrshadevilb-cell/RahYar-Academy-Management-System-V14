# Telegram
BOT_TOKEN=
BOT_USERNAME=
PROXY_URL=

# Database
DATABASE_URL=postgresql+psycopg://rahyar:CHANGE_ME@postgres:5432/rahyar
REDIS_URL=redis://redis:6379/0

SPOTPLAYER_API_KEY=
OWNER_ID=

SITE_NAME=آکادمی راه‌یار
SITE_TAGLINE=آموزش حرفه‌ای موسیقی — دوره‌های دیجیتال و کلاس آنلاین

DEBUG=false
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DEFAULT_CARD_NUMBER=
DEFAULT_CARD_HOLDER=

# ---------------------------------------------------------------------------
# AI Developer Agent / shared AI provider pool
# Prefer free/active models. Router tries free-first, then priority order.
# ---------------------------------------------------------------------------
AI_AGENT_ENABLED=true

# Primary OpenAI-compatible (or gateway) provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional secondary failover (used automatically when primary is limited)
AI2_API_KEY=
AI2_BASE_URL=
AI2_MODEL=

# Optional multi-provider JSON pool (takes precedence over AI_*/AI2_* when set).
# Reference secrets by env var name — never put raw keys in JSON committed to git.
# Example:
# AI_PROVIDERS_JSON=[{"name":"openrouter","api_key_env":"OPENROUTER_API_KEY","base_url":"https://openrouter.ai/api/v1","models":["meta-llama/llama-3.3-70b-instruct:free","google/gemini-2.0-flash-exp:free"],"priority":10},{"name":"secondary","api_key_env":"AI2_API_KEY","base_url":"https://api.example.com/v1","models":["gpt-4o-mini"],"priority":20}]
AI_PROVIDERS_JSON=

# Optional named provider keys (also usable from admin/DB discovery)
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=
AGENTROUTER_API_KEY=
GOOGLE_API_KEY=
KIRAAI_API_KEY=

AI_AGENT_MAX_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=180
AI_FALLBACK_MODEL=

# Online write mode on Render (optional, owner only via Telegram panel)
# When enabled, agent can clone, edit on ai/*, run tests, push, and open PR.
AI_AGENT_WRITE_ENABLED=false
AI_AGENT_WORK_DIR=/tmp/rahyar-agent-repo
GITHUB_TOKEN=
GITHUB_REPO=mehrshadevilb-cell/RahYar-Academy-Management-System-V14

# Student chat assistant (shared by Telegram + ArtistYar website)
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_MAX_MESSAGES_PER_HOUR=20
# Optional override; otherwise falls back to AI_* pool
CHAT_ASSISTANT_API_KEY=
CHAT_ASSISTANT_BASE_URL=
CHAT_ASSISTANT_MODEL=

# AI knowledge engine
# Empty = capture all groups where the bot receives messages; safer option is explicit group IDs.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_GROUP_IDS=
KNOWLEDGE_FETCH_INTERVAL_HOURS=24
KNOWLEDGE_AUTO_QUIZ=true
KNOWLEDGE_QUIZ_INTERVAL_HOURS=24
